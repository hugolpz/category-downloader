# Server-side settings (read at runtime by server/index.mjs; nothing here reaches the browser bundle).
# Wikimedia OAuth 2.0 consumer, CONFIDENTIAL. Register at
# https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
# Grants: basic + high-volume (bot) access. One callback URL per consumer, so dev and production need one each.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Dev: http://localhost:8079/oauth/wikimedia/success   Production: https://commons-flow.toolforge.org/
OAUTH_REDIRECT_URI=http://localhost:8079/oauth/wikimedia/success
# Contact (URL or email) put in the User-Agent sent to Wikimedia, as their policy requires.
CONTACT=
# Only if the host tells the app which port to use (Toolforge's classic Node web service listens on 8000).
# PORT=8000
